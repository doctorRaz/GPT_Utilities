<Project>
	<!-- <Import Project="d:\@Developers\Programmers\!NET\Shared\Directory.Build\Directory.Build.props" /> -->
	<PropertyGroup>
		<!-- Короткий идентификатор разработчика -->
		<Vendor>dRz</Vendor>
		<!--RootNamespace default-->
		<RootNamespace>$(Vendor).$(SolutionName).$(MSBuildProjectName)</RootNamespace>
		<!-- Версия языка -->
		<LangVersion>latest</LangVersion>
		<!-- Nullable Reference Types -->
		<Nullable>enable</Nullable>
		<!-- Не добавлять TargetFramework в путь вывода -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<!-- путь сборки в каталоге решения общий bin -->
		<BaseOutputPath>..\bin\</BaseOutputPath>
		<OutputPath>$(SolutionDir)bin\$(Configuration)</OutputPath>
		<!--название файла сборки-->
		<!--<AssemblyName>$(SolutionName).$(MSBuildProjectName)</AssemblyName>-->
	</PropertyGroup>
	<!-- ================================================================= -->
	<!-- Версия сборки                                                     -->
	<!-- ================================================================= -->
	<PropertyGroup>
		<!-- Базовая версия продукта -->
		<Version Condition="'$(Version)' == ''">0.1</Version>
		<!--
			Версия аналогична механизму AssemblyVersion=0.1.*
			Build  = количество дней от 01.01.2000
			Revision = секунды от начала суток / 2
		-->
		<Build>$([System.DateTime]::Now.Subtract($([System.DateTime]::Parse('2000-01-01'))).Days)</Build>
		<Revision>$([MSBuild]::Divide($([System.DateTime]::Now.TimeOfDay.TotalSeconds), 2).ToString("F0"))</Revision>

		<!-- Не генерировать второй AssemblyFileVersion -->
		<!--<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>-->
	</PropertyGroup>
	<!-- ***************************************************************** -->
	<!-- Информация о продукте                                             -->
	<!-- ***************************************************************** -->
	<PropertyGroup>
		<!-- ProductName -->
		<Product>$(SolutionName)</Product>
		<AssemblyTitle>$(SolutionName) $(MSBuildProjectName)</AssemblyTitle>
		<Description>Утилиты для ЖОПИТЕ</Description>
		<Company>doctorRaz Technologies</Company>
		<Trademark>doctorRaz</Trademark>
		<StartYear>2014</StartYear>
		<CurrentYear>$([System.DateTime]::Now.Year)</CurrentYear>
		<!-- Авторские права -->
		<Copyright>©Разыграев Андрей $(StartYear)-$(CurrentYear)</Copyright>
		<!-- Домашняя страница проекта -->
		<RepositoryUrl>https://github.com/doctorRaz</RepositoryUrl>
		<NeutralLanguage>ru-RU</NeutralLanguage>
	</PropertyGroup>
	<!-- ================================================================= -->
	<!-- Дополнительные метаданные сборки                                  -->
	<!-- ================================================================= -->
	<ItemGroup>
		<!--
			ContactEmail
			ContactEmailBackup
			SupportEmail
			LicenseEmail
			VendorEmail
		-->
		<!-- Контактная информация -->
		<AssemblyMetadata Include="ContactEmail" Value="razygraev@gmail.com"/>
		<AssemblyMetadata Include="SupportEmail" Value="doctorRaz@gmail.com"/>
		<AssemblyMetadata Include="VendorEmail" Value="doctorRaz@yandex.ry"/>
		<!--домашняя страница-->
		<AssemblyMetadata Include="HomePage" Value="https://doctorraz.blogspot.com"/>
		<!-- Семейство Host -->
		<AssemblyMetadata Include="HostFamily" Value="$(HostFamily)"/>
		<!-- Код Host -->
		<AssemblyMetadata Include="HostCode" Value="$(HostCode)"/>
		<!--Product может быть красивым названием, а ProductFamily удобно использовать программно.-->
		<AssemblyMetadata Include="ProductFamily" Value="$(SolutionName)$(HostCode)"/>
		<AssemblyMetadata Include="Vendor" Value="$(Vendor)"/>
	</ItemGroup>
	<!-- ================================================================= -->
	<!-- Дополнительные настройки Release                                  -->
	<!-- ================================================================= -->
	<PropertyGroup Condition="'$(Configuration)'!= 'Debug'">
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>
</Project>
